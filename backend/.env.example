# =============================================================================
# Gideon backend configuration
#
# Copy to `.env` and fill in what you need:
#     cp .env.example .env
#
# Only the REQUIRED block is needed to boot. Everything else is optional, and
# any integration you leave blank simply does not appear as a tool.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# At least one LLM provider key. Anthropic is the default for every feature.
ANTHROPIC_API_KEY=

# Postgres and Redis. The docker-compose file provides both at these defaults.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local
POSTGRES_DB=gideon
# Alternatively set a full URI and the individual values above are ignored:
# POSTGRES_URI_GIDEON=postgresql+psycopg_async://user:pass@host:5432/gideon
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Encrypts OAuth tokens and message content at rest. Generate one with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this after data exists makes previously encrypted rows unreadable.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------

# single_user (default) — no login; every request is the one local user below.
#                         Do not expose an instance in this mode to a network
#                         you do not control.
# oidc                  — validate bearer tokens against any OIDC provider.
AUTH_MODE=single_user

SINGLE_USER_EMAIL=you@example.com
SINGLE_USER_NAME=Your Name
# Stable UUID for the local user. Used only in AUTH_MODE=single_user (local dev).
# Generate your own with: python -c "import uuid; print(uuid.uuid4())"
# Change only on a fresh database — existing rows are keyed to this value.
SINGLE_USER_ID=

# AUTH_MODE=oidc only. Point at your provider's userinfo endpoint.
# Google:   https://openidconnect.googleapis.com/v1/userinfo
# Okta:     https://<domain>/oauth2/v1/userinfo
# Keycloak: https://<host>/realms/<realm>/protocol/openid-connect/userinfo
OIDC_USERINFO_URL=
OIDC_ID_CLAIM=sub
OIDC_EMAIL_CLAIM=email
OIDC_ROLES_CLAIM=roles

# Restrict sign-in to these email domains (comma-separated, bare domains).
# Empty accepts any authenticated email.
ALLOWED_EMAIL_DOMAINS=

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------

# Public URL of the frontend. Used in links Gideon sends over Slack and email.
GIDEON_APP_URL=http://localhost:3000

# Origins allowed to call the API (comma-separated, exact matches).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Grants admin-only UI surfaces to these addresses.
ADMIN_EMAIL=

# Your organisation's primary email domain, e.g. example.com. When set, a
# person's address on this domain is treated as canonical and duplicate
# personal accounts in Slack are folded into it.
PRIMARY_EMAIL_DOMAIN=

# -----------------------------------------------------------------------------
# LLM PROVIDERS AND ROUTING
# -----------------------------------------------------------------------------

OPENAI_API_KEY=
# Point at any OpenAI-compatible server (vLLM, Ollama, OpenRouter, LiteLLM, ...).
# Leave blank for OpenAI itself.
OPENAI_BASE_URL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Every AI feature can be routed independently. Provider is one of
# anthropic | openai | kimi. Examples:
#     PROVIDER_CHAT=anthropic
#     MODEL_CHAT=claude-opus-4-8
#     PROVIDER_TRIGGER_AGENT=kimi
#     MODEL_TRIGGER_AGENT=kimi-k2.6
# Features: CHAT, AGENT, WORKFLOW, ADVISOR, TRIGGER_AGENT, MEETING_PREP,
# EMAIL_DRAFT, SURVEY_ANALYSIS, SMART_ONBOARDING, SKILL_LEARNING,
# WORKFLOW_PREVIEW, WORKFLOW_SUGGESTIONS, TITLE_GEN, SUGGESTIONS.

# Model used when the primary chat model is unavailable.
CHAT_FALLBACK_MODEL=claude-sonnet-5

# Anthropic-only second opinion on hard calls. Ignored on other providers.
ADVISOR_ENABLED=true

# -----------------------------------------------------------------------------
# INTEGRATIONS (all optional)
#
# Each block enables one tool group. Leave blank to omit that integration.
# -----------------------------------------------------------------------------

# Google (Gmail, Calendar, Drive, Docs, Sheets). OAuth client with those scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Slack. Needs a bot token for Gideon's own identity, plus an OAuth app if you
# want per-user Slack access.
GIDEON_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Deep-link base for Slack permalinks, e.g. https://myworkspace.slack.com/archives
SLACK_ARCHIVE_BASE=
# Optional {"email": "U012345"} JSON, for people whose Slack lookup is unreliable.
SLACK_ID_OVERRIDES=
# Channel that "request an integration" feedback is posted to. Sent with the
# requesting user's own Slack token, so it's a channel in THEIR workspace.
FEEDBACK_SLACK_CHANNEL=#gideon-feedback

# Notion, Linear, GitHub
NOTION_MCP_CLIENT_ID=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Exa (web search)
EXA_API_KEY=

# The mailbox Gideon listens on. CC it to trigger a run from email.
GIDEON_INBOX_EMAIL=

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Grafana (dashboard + panel queries)
GRAFANA_URL=
GRAFANA_TOKEN=

# Meta Ads
META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=

# Weather for the hub panel (OpenWeather)
WEATHER_API_KEY=

# Other SaaS tools
FRESHDESK_API_URL=
FRESHDESK_API_KEY=
FRESHCHAT_INSTANCE_URL=
FRESHCHAT_API_KEY=
SEMRUSH_API_KEY=
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# Only needed by the list_figma_team_projects tool. The number in
# https://figma.com/files/team/<id>/... Every other Figma tool works from a
# file URL and needs nothing here.
FIGMA_TEAM_ID=

# -----------------------------------------------------------------------------
# ANALYTICS WAREHOUSE (optional)
#
# Lets Gideon answer questions by writing SQL against your ClickHouse.
# -----------------------------------------------------------------------------

CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true

# Describe your tables so the model writes correct SQL. Path to a JSON or YAML
# file; see the format documented in backend/tools/analytics_tool.py. Without
# one, Gideon falls back to live SHOW TABLES / DESCRIBE discovery.
ANALYTICS_TABLES_FILE=

# Permission string granting unrestricted read of the warehouse.
ANALYTICS_BROAD_READ_PERMISSION=clickhouse:reader

# Map permissions to the tables they grant, as JSON:
#     {"analytics.ops:reader": ["orders"]}
ANALYTICS_PERMISSION_MAP=

# Friendly names the model may use for a table, as a JSON object:
#     {"signups": "user_registration_events"}
ANALYTICS_TABLE_ALIASES=

# -----------------------------------------------------------------------------
# SURVEYS (optional)
# -----------------------------------------------------------------------------

# Comma-separated emails allowed to build and run surveys. Empty disables the
# survey admin endpoints and the survey-builder tools entirely.
SURVEY_ADMINS=

# Teach Gideon your org's audience shorthand ("ops PMs" -> which departments +
# role keywords select those people). A JSON array, or a path to a .json file.
# Empty by default: department and role names differ per organization, so with
# nothing set Gideon confirms the target audience with the admin instead.
#     [{"key":"eng_leads","aliases":["eng leads"],"description":"Engineering
#       leadership (~8 people).","departments":["Engineering"],
#       "role_keywords":["Lead","Head","Director"]}]
SURVEY_COHORT_PRESETS=

# -----------------------------------------------------------------------------
# PRODUCT ANALYTICS (optional, OFF by default)
#
# Gideon never phones home unless you set a backend here.
#   none (default) | posthog | webhook
# -----------------------------------------------------------------------------

ANALYTICS_BACKEND=none
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# MEMORY GRAPH (optional)
#
# Neo4j powers the long-term memory graph. Without it, memory falls back to
# Postgres and the graph features are skipped.
# -----------------------------------------------------------------------------

NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# -----------------------------------------------------------------------------
# OPERATIONS (optional)
# -----------------------------------------------------------------------------

# Error tracking.
SENTRY_URL=

# Returns 503 on every request except the health probe. For planned migrations.
MAINTENANCE_MODE=
MAINTENANCE_MESSAGE=

# Slack user IDs to notify about operational problems (e.g. a dead OAuth token).
# Empty disables those alerts.
ADMIN_ALERT_SLACK_USER_ID=
RCA_SLACK_USER_ID=
