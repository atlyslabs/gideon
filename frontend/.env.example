# =============================================================================
# Gideon frontend configuration
#
#     cp .env.example .env.local
#
# NEXT_PUBLIC_* variables are inlined by Next.js AT BUILD TIME. Changing one
# means rebuilding, not just restarting. They are also visible to anyone who
# loads the page, so never put a secret in a NEXT_PUBLIC_ variable.
#
# Nothing here is required to boot. The defaults assume the backend is on
# localhost:8080 and the app is on localhost:3000.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------

# Where the backend API lives.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public URL of this app. Used to build absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL for the login/identity calls. Defaults to the same origin when unset,
# which is correct unless auth is served from somewhere else.
NEXT_PUBLIC_AUTH_API_URL=

# Comma-separated emails that unlock admin-only UI surfaces.
NEXT_PUBLIC_ADMIN_EMAILS=

# Integrations a user must connect before the app will open, as provider keys
# (e.g. google,slack). Empty by default: nothing is required and the app opens
# immediately. Only set this if your deployment genuinely cannot function
# without those connections, and only for providers you have configured OAuth
# credentials for on the backend — otherwise the gate cannot be satisfied and
# the instance is unusable.
NEXT_PUBLIC_REQUIRED_INTEGRATIONS=

# Your Slack workspace id (the T0... value). Used to target slack:// deep links
# at a specific workspace. Unset is fine: links then open in whichever
# workspace the user's Slack app currently has active.
NEXT_PUBLIC_SLACK_TEAM_ID=

# -----------------------------------------------------------------------------
# AUTH (only when the backend runs AUTH_MODE=oidc with Google)
# -----------------------------------------------------------------------------

# Google OAuth client id for the sign-in button. Leave blank in single_user
# mode, where there is no login screen.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# SERVER-SIDE (not exposed to the browser)
# -----------------------------------------------------------------------------

# Enables in-chat React previews. Must point at a service exposing
# POST /compile. Unset, that route returns 501 and the rest of the app is fine.
PREVIEW_BUILDER_URL=

# OpenWeather key for the hub's city search route. Unset disables city lookup.
WEATHER_API_KEY=

# -----------------------------------------------------------------------------
# APPEARANCE (all optional)
# -----------------------------------------------------------------------------

# Base URL hosting weather backdrop videos, expected as <base>/<condition>.mp4.
# Unset falls back to a CSS gradient, which is the shipped default.
NEXT_PUBLIC_WEATHER_VIDEO_BASE=

# Overrides the 3D model behind the holographic particle effect. Defaults to the
# bundled public/orb.obj. Any .obj works.
NEXT_PUBLIC_HEAD_MODEL_URL=

# Plays a chime when a response finishes. No audio file ships with the project,
# so this is off unless you host one.
NEXT_PUBLIC_NOTIFICATION_SOUND_URL=

# How streamed text animates in. One of:
#   character-ripple (default), typewriter, pulsing-caret, word-blur,
#   chunk-rise, depth-of-field, thinking-dots, gradient-sweep,
#   shimmer-trail, block-fade
# An unrecognised value silently falls back to the default.
NEXT_PUBLIC_STREAM_VARIANT=

# Build identifier shown on the About page. Usually set by CI to the commit sha.
NEXT_PUBLIC_GIT_SHA=
